# ─── Enlazia configuration / configuración ───────────────────────────

# Port and host. cPanel/Passenger sets PORT automatically.
# Puerto y host. En cPanel/Passenger el PORT lo asigna el servidor.
PORT=8787
HOST=127.0.0.1

# Folder for the SQLite database, master key and custom connectors.
# Carpeta para la base SQLite, la llave maestra y conectores propios.
ENLAZIA_DATA_DIR=./data

# Access password. REQUIRED if the instance is reachable from the internet.
# Contraseña de acceso. OBLIGATORIA si la instancia es accesible desde internet.
ENLAZIA_PASSWORD=

# 32-byte key (base64) used to encrypt API keys at rest. If empty, one is
# generated in ENLAZIA_DATA_DIR/.master-key. Generate: openssl rand -base64 32
# Llave de 32 bytes (base64) para cifrar las API keys. Si está vacía se genera
# una en ENLAZIA_DATA_DIR/.master-key. Generar: openssl rand -base64 32
ENLAZIA_MASTER_KEY=

# Advanced: project root and built UI folder (auto-detected by default).
# Avanzado: raíz del proyecto y carpeta de la UI compilada (se detectan solas).
# ENLAZIA_ROOT=
# ENLAZIA_WEB_DIR=apps/web/dist

# Public demo mode: catalog and docs only, saving credentials is disabled.
# Modo demo público: solo catálogo y documentación, no se guardan credenciales.
ENLAZIA_DEMO=false
