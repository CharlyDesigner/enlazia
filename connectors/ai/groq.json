{
  "$schema": "../../schemas/connector.schema.json",
  "id": "groq",
  "name": "Groq",
  "category": "ai",
  "kind": "ai-openai-compatible",
  "description": {
    "es": "Inferencia ultrarrápida de modelos abiertos sobre LPU.",
    "en": "Ultra-fast inference of open models on LPUs."
  },
  "website": "https://groq.com",
  "docs": "https://console.groq.com/docs",
  "color": "#F55036",
  "tags": [
    "llm",
    "fast",
    "open-weights"
  ],
  "baseUrl": "https://api.groq.com/openai/v1",
  "auth": {
    "type": "bearer",
    "field": "apiKey"
  },
  "fields": [
    {
      "key": "apiKey",
      "label": {
        "es": "Clave de API",
        "en": "API key"
      },
      "type": "secret",
      "required": true
    }
  ],
  "models": {
    "listable": true,
    "suggested": [
      "openai/gpt-oss-120b",
      "openai/gpt-oss-20b",
      "llama-3.3-70b-versatile",
      "llama-3.1-8b-instant"
    ]
  }
}
